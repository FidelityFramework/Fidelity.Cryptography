module Fidelity.Cryptography.Examples.Hash

open Fidelity.Cryptography.Hash.Sha256

let private equalOctets (left: int array) (right: int array) : bool =
    let mutable index: int = 0
    let mutable equal: bool = Array.length left = Array.length right
    while equal && index < Array.length left do
        if Array.get left index <> Array.get right index then equal <- false else ()
        index <- index + 1
    equal

[<EntryPoint>]
let main _ =
    let input: int array = [| 97; 98; 99 |]
    let digest: int array = Array.zeroCreate 32
    let expected: int array =
        [| 186; 120; 22; 191; 143; 1; 207; 234
           65; 65; 64; 222; 93; 174; 34; 35
           176; 3; 97; 163; 150; 23; 122; 156
           180; 16; 255; 97; 242; 0; 21; 173 |]
    match hashInto input digest with
    | Error _ -> 1
    | Ok _ -> if equalOctets digest expected then 0 else 2
